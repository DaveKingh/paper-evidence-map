{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-evidence-map:schema:gap:0.2",
  "title": "Paper Evidence Map Candidate Gap",
  "description": "Machine-readable contract for a traceable paper-derived gap. Origin, internal support, and external novelty are independent dimensions.",
  "type": "object",
  "required": [
    "gap_id",
    "origin",
    "observation",
    "evidence_refs",
    "gap_status",
    "novelty_status",
    "verification_needed"
  ],
  "properties": {
    "gap_id": {
      "type": "string",
      "pattern": "^G[0-9]{2,}$"
    },
    "origin": {
      "enum": ["explicit", "inferred"]
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reasoning_chain": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "alternative_explanations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "gap_status": {
      "enum": ["candidate", "supported", "contradicted", "unresolved"]
    },
    "novelty_status": {
      "enum": ["unchecked", "partially_checked", "no_close_prior_found", "contradicted", "unclear"]
    },
    "novelty_check": {
      "type": ["object", "null"],
      "properties": {
        "query_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sources_searched": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "date": {"type": ["string", "null"], "format": "date"},
        "close_prior_work": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "verification_needed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"origin": {"const": "inferred"}}, "required": ["origin"]},
      "then": {
        "required": ["reasoning_chain", "alternative_explanations"],
        "properties": {
          "reasoning_chain": {"minItems": 1},
          "alternative_explanations": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "novelty_status": {
            "enum": ["partially_checked", "no_close_prior_found", "contradicted", "unclear"]
          }
        },
        "required": ["novelty_status"]
      },
      "then": {
        "required": ["novelty_check"],
        "properties": {"novelty_check": {"type": "object"}}
      }
    }
  ]
}
